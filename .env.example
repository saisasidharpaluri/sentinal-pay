# ==============================================================================
# Sentinel-Pay Environment Variables
# ==============================================================================

# AI Model Provider (Optional)
# If provided, Sentinel uses OpenAI via Vercel AI SDK for natural language agent reasoning.
# If omitted or invalid, Sentinel-Pay includes an intelligent fallback parser for all evaluation presets.
OPENAI_API_KEY=your_openai_api_key_here

# Razorpay Testnet Credentials (Optional)
# If omitted, Sentinel-Pay runs in high-fidelity mock mode generating realistic orders & HMAC-SHA256 signatures.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Application Host URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
