# ==============================================================================
# Sentinel-Pay Environment Variables
# ==============================================================================

# AI intent extraction. Locally, add an AI Gateway key for model parsing.
# On Vercel, AI Gateway can use deployment OIDC when the integration is enabled.
# Without available AI Gateway authentication, the console visibly labels fallback parsing.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Application Host URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
